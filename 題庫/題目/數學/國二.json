    "id": "M-N2-0153",
    "題幹": "將 $(x+3)^2$ 展開後，下列何者正確？",
    "選項": [
      "$x^2+9$",
      "$x^2+6x+9$",
      "$x^2+3x+9$",
      "$x^2+6x+6$"
    ],
    "答案": 1,
    "難度": 2,
    "圖片": null,
    "解析": "和的平方公式：$(a+b)^2=a^2+2ab+b^2$，所以 $(x+3)^2=x^2+6x+9$。",
